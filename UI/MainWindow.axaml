<Window xmlns:local="clr-namespace:UI"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        x:Class="UI.MainWindow"
        Width="800" Height="600"
        Title="File Viewer">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <Button Content="Open File"
                    Click="OpenFile_Click"/>
            
            <Button Name="AddFilter_Button"
                    Content="Add Filter">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Width="250" Spacing="10" Margin="5">
                            <TextBlock Text="Add New Filter" FontWeight="Bold"/>
                            
                            <TextBox Name="FilterPatternInput" Watermark="Search pattern..."/>
                            
                            <CheckBox Name="MatchCaseCheck" Content="Match Case"/>
                            <CheckBox Name="RegexCheck" Content="Use Regex"/>
                            <CheckBox Name="ExcludeCheck" Content="Exclude Matches (Inverse)"/>
                            
                            <Button Content="Add to List" 
                                    HorizontalAlignment="Right"
                                    Click="ConfirmAddFilter_Click"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" 
        Height="150" 
        Background="#F5F5F5" 
        BorderBrush="Gray" 
        BorderThickness="0,1,0,0">
            <DockPanel Margin="5">
                <TextBlock DockPanel.Dock="Top" Text="Active Filters" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:DataType="local:MainWindow" ItemsSource="{Binding Filters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:FilterItem">
                                <Border Background="White" 
                                        BorderBrush="#DDD" 
                                        BorderThickness="0,0,0,1" 
                                        Padding="10,5">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Content="✕" 
                                                Click="DeleteFilter_Click"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"/>

                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="5" Margin="10,0">
                                            <Border Background="#EEE" CornerRadius="3" Padding="4,2" IsVisible="{Binding IsCaseSensitive}">
                                                <TextBlock Text="Aa" FontSize="10" Foreground="Gray"/>
                                            </Border>
                                            <Border Background="#EEE" CornerRadius="3" Padding="4,2" IsVisible="{Binding IsRegex}">
                                                <TextBlock Text="Regex" FontSize="10" Foreground="Gray"/>
                                            </Border>
                                            <Border Background="#FFE0E0" CornerRadius="3" Padding="4,2" IsVisible="{Binding IsExclude}">
                                                <TextBlock Text="!" FontSize="10" Foreground="Red" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Pattern}" 
                                                VerticalAlignment="Center" 
                                                TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ae:TextEditor Name="Editor"
                       ShowLineNumbers="False" 
                       IsVisible="False"
                       IsReadOnly="True"
                       VerticalAlignment="Stretch"
                       HorizontalAlignment="Stretch"
                       Background="White" 
                       Foreground="Black"
                       FontFamily="Consolas"/>
    </DockPanel>
</Window>
